{
  "client": {
    "source": "client",
    "scripts": {
      "build": "npm run build"
    },
    "hosting": {
      "dir": "dist"
    }
  },
  "functions": {
    "source": "functions",
    "targets": [
      "fir_api",
      "zia_voice",
      "zia_brief",
      "crime_chat",
      "co_accused_network",
      "accused_at_large",
      "chargesheet_clock",
      "legal_rag",
      "quickml_predict",
      "alert_job",
      "ocr_extract",
      "veracity_index",
      "topology_navigator",
      "victim_risk_shield",
      "gbv_analytics",
      "solvability_index",
      "dark_figure",
      "countercrime",
      "fir_quality",
      "fairness_audit",
      "case_management",
      "agentic_police",
      "daily_brief",
      "beat_optimizer",
      "transit_detection",
      "exceedance_curve",
      "precompute_job",
      "predictive_mode",
      "face_analytics"
    ]
  },
  "api_gateway": [
    {
      "name": "default",
      "description": "Default API Gateway — rate limiting and auth for all functions",
      "resources": [
        {
          "path": "/**",
          "method": "ANY",
          "throttling": {
            "enabled": true,
            "rate_limit": 100,
            "burst_limit": 200
          },
          "authentication": {
            "enabled": false,
            "type": "none"
          }
        },
        {
          "path": "/server/login",
          "method": "POST",
          "authentication": {
            "enabled": false,
            "type": "none"
          }
        }
      ]
    }
  ],
  "cron": [
    {
      "name": "alert-job",
      "description": "Daily anomaly alert scan — runs every 30 min during peak hours",
      "function": "alert_job",
      "schedule": "*/30 * * * *",
      "timeout": 300
    },
    {
      "name": "precompute-job",
      "description": "Precompute analytics data — runs every 6 hours",
      "function": "precompute_job",
      "schedule": "0 */6 * * *",
      "timeout": 600
    }
  ]
}
